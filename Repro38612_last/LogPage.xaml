<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Repro38612.LogPage"
             Title="Log"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Padding="8" Spacing="8">
            <Button Text="Osveži" Clicked="OnRefresh" />
            <Button Text="Počisti" Clicked="OnClear" />
            <Button Text="Deli" Clicked="OnShare" />
        </HorizontalStackLayout>
        <ScrollView Grid.Row="1">
            <Label x:Name="logLabel" FontSize="11" Padding="8" TextColor="Black" LineBreakMode="WordWrap" />
        </ScrollView>
    </Grid>
</ContentPage>
